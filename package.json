{
  "name": "medalmap",
  "version": "1.0.0",
  "description": "Web app showing where Olympic medalists were born.",
  "author": "Vegard Egeland",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "typecheck": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "pipeline:wikipedia": "tsx scripts/wikipedia.ts",
    "pipeline:wikidata": "tsx scripts/wikidata.ts",
    "pipeline:coverage": "tsx scripts/coverage.ts",
    "pipeline:merge": "tsx scripts/merge.ts"
  },
  "dependencies": {
    "maplibre-gl": "^5.20.2",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@preact/preset-vite": "^2.10.6",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.9.9",
    "node-html-parser": "^9.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
